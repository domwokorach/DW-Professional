    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "cobe": "^0.6.5",
    "dotenv": "^18.0.5",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
