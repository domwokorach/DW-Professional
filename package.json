{
  "name": "dw-professional",
  "version": "1.0.0",
  "private": true,
  "description": "Professional portfolio website for Dominic — Software Engineer & Frontend Developer.",
  "keywords": [
    "portfolio",
    "software-engineer",
    "frontend-developer",
    "full-stack",
    "nextjs",
    "typescript",
    "react"
  ],
  "homepage": "https://github.com/domwokorach/DW-Professional#readme",
  "bugs": {
    "url": "https://github.com/domwokorach/DW-Professional/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domwokorach/DW-Professional.git"
  },
  "license": "ISC",
  "author": "Dominic W",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-stack-icons.mts",
    "prebuild": "npm run icons && npm run db:generate && npm run companies:generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate && npm run companies:generate",
    "typecheck": "tsc --noEmit",
    "companies:generate": "prisma generate --config prisma.company.config.ts",
    "companies:migrate": "prisma migrate deploy --config prisma.company.config.ts",
    "companies:migrate:dev": "prisma migrate dev --config prisma.company.config.ts",
    "companies:import": "tsx scripts/import-companies.ts",
    "admin": "tsx scripts/admin-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@base-ui/react": "^1.8.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-spring/web": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "cobe": "^0.6.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.5",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "resend": "^6.32.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/tabler": "^1.2.41",
    "@iconify/utils": "^3.1.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
