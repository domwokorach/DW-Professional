{
  "name": "dominic-wokorach-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "A modern professional portfolio showcasing my work as a Software Engineer & Frontend Developer.",
  "homepage": "https://github.com/domwokorach/DW-Professional#readme",
  "bugs": {
    "url": "https://github.com/domwokorach/DW-Professional/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domwokorach/DW-Professional.git"
  },
  "license": "MIT",
  "author": "Dominic Wokorach Olanya",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "build": "prisma generate --schema prisma/schema.prisma && prisma migrate deploy --schema prisma/schema.prisma; next build",
    "start": "next start",
    "lint": "eslint src scripts --max-warnings=0",
    "test:accessibility": "playwright test",
    "setup:vector-store": "node --env-file=.env.local scripts/setup-vector-store.mjs",
    "email:dev": "email dev --dir src/services/email/templates",
    "email:dev:resume": "email dev --dir emails",
    "socket:dev": "tsx watch --env-file=.env.local server/socket-server.ts",
    "socket:start": "tsx server/socket-server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand --reporters=default",
    "auth:create-admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts"
  },
