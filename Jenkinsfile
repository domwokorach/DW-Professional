// Declarative pipeline for DW-Professional (Next.js web app, Expo app, design-token package).
//
// Agent requirements: Node.js >= 22 and npm on PATH (macOS or Linux), git, and Chromium-capable
// (Playwright downloads its own browser). The Jenkins "JUnit" plugin must be installed.
//
// Optional parameters:
//   TEST_DATABASE_URL  A THROWAWAY Postgres database (never a real one) with both migration sets applied
//                      (see docs/TESTING.md). Without it the database-backed integration tests are
//                      reported as skipped, and the log says so.
//   DEPLOYMENT_URL     A deployed base URL. When set, the final stage runs the post-deployment smoke tests.
//
// No credentials are required or read. Nothing here deploys; deployment is Vercel's Git integration.

pipeline {
  agent any

  options {
    timeout(time: 45, unit: 'MINUTES')
    timestamps()
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
    skipDefaultCheckout(true)
  }

  parameters {
    string(name: 'TEST_DATABASE_URL', defaultValue: '', description: 'Throwaway Postgres URL for integration tests (leave empty to skip them)')
    string(name: 'DEPLOYMENT_URL', defaultValue: '', description: 'Deployed base URL to smoke-test (leave empty to skip)')
  }

  environment {
    CI = 'true'
    NEXT_TELEMETRY_DISABLED = '1'
    // npm's cache lives outside the workspace, so a clean workspace still installs from a warm cache.
    npm_config_cache = "${env.HOME}/.npm"
    PLAYWRIGHT_BROWSERS_PATH = "${env.HOME}/.cache/ms-playwright"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        // Clean, reproducible workspace without a plugin: remove everything untracked or ignored (node_modules is reinstalled by npm ci).
        sh 'git clean -ffdx'
        sh 'git log -1 --format="commit %H%n%an%n%s"'
      }
    }

    stage('Validate environment') {
      steps {
        sh '''
          set -e
          node --version
          npm --version
          major="$(node -p "process.versions.node.split('.')[0]")"
          if [ "$major" -lt 22 ]; then echo "Node.js >= 22 is required (found $(node --version))"; exit 1; fi
          test -f package-lock.json || { echo "package-lock.json is missing; npm ci needs it"; exit 1; }
        '''
      }
    }

    stage('Install dependencies') {
      steps {
        // postinstall also generates both Prisma clients, so they are not generated again below.
        sh 'npm ci --prefer-offline --no-audit --no-fund'
      }
    }

    stage('Prisma clients') {
      steps {
        // Only generate when postinstall did not (avoids a duplicate generate on every build).
        sh '''
          if [ -d generated ] && [ -n "$(ls -A generated 2>/dev/null)" ]; then
            echo "Prisma clients already generated by postinstall."
          else
            npx prisma generate && npm run companies:generate
          fi
        '''
      }
    }

    stage('Static analysis') {
      parallel {
        stage('ESLint') {
          steps { sh 'npm run lint' }
        }
        stage('TypeScript (web)') {
          steps { sh 'npm run typecheck:web' }
        }
        stage('TypeScript (Expo)') {
          steps { sh 'npm run typecheck:mobile' }
        }
        stage('Dependency audit') {
          steps {
            sh 'npm audit signatures'
            sh 'npm audit --omit=dev --audit-level=critical'
            // Full report for the archive; the known, unfixable-without-downgrade findings are in SECURITY.md.
            sh 'mkdir -p reports && (npm audit --omit=dev > reports/npm-audit.txt || true)'
          }
        }
      }
    }

    stage('Tests') {
      stages {
        stage('Reset coverage data') {
          steps { sh 'npm run coverage:clean' }
        }
        stage('Run suites') {
          parallel {
        stage('Unit') {
          steps { sh 'node scripts/run-tests.mjs unit --collect' }
        }
        stage('Component') {
          steps { sh 'node scripts/run-tests.mjs component --collect' }
        }
        stage('Integration') {
          steps {
            script {
              if (!params.TEST_DATABASE_URL?.trim()) {
                echo 'TEST_DATABASE_URL is not set: database-backed integration tests will be reported as SKIPPED, not passed.'
              }
            }
            sh 'TEST_DATABASE_URL="$TEST_DATABASE_URL" node scripts/run-tests.mjs integration --collect'
          }
        }
          }
        }
      }
    }

    stage('Coverage') {
      steps { sh 'npm run coverage:report' }
    }

    stage('Production build') {
      steps {
        // `next build` directly: Prisma clients were generated above, so `npm run build`'s prebuild would repeat it.
        sh 'npm run icons && npx next build'
      }
    }

    stage('Browser tests') {
      parallel {
        stage('E2E') {
          steps {
            sh 'npx playwright install chromium'
            sh 'npx playwright test --project=chromium --project=mobile'
          }
        }
        stage('Expo and design tokens') {
          steps {
            sh 'npm run package:build'
            // Bundles the Expo app for web; fails on unresolved imports or syntax errors.
            sh 'cd apps/mobile && npx expo export --platform web --output-dir ../../reports/expo-web'
          }
        }
      }
    }

    stage('Accessibility') {
      steps {
        sh 'npx playwright test --project=a11y --project=a11y-mobile'
      }
    }

    stage('Verify deployment') {
      when { expression { params.DEPLOYMENT_URL?.trim() } }
      steps {
        sh 'PLAYWRIGHT_BASE_URL="$DEPLOYMENT_URL" npx playwright test --project=smoke'
      }
    }
  }

  post {
    always {
      script {
        // Publish whatever reports exist, even when a stage failed. Real failures are kept (the build is
        // marked failed/unstable); nothing is generated here and empty results are not accepted silently.
        def reports = findFiles(glob: 'reports/junit/*.xml')
        if (reports.length > 0) {
          junit testResults: 'reports/junit/*.xml', allowEmptyResults: false
        } else {
          echo 'NO JUNIT REPORTS were produced. Tests did not run: an earlier stage (checkout, install, lint or type-check) failed before the test stages started.'
          if (currentBuild.currentResult == 'SUCCESS') {
            error('Pipeline reported success but no JUnit reports exist; the report path or runner is misconfigured.')
          }
        }
        archiveArtifacts artifacts: 'reports/**, playwright-report/**, test-results/**, coverage/**', allowEmptyArchive: true, fingerprint: true
      }
    }
    success { echo 'Pipeline passed. Every required stage ran and passed.' }
    failure { echo 'Pipeline failed. See the first failing stage; reports from stages that ran were still published.' }
    unstable { echo 'Pipeline unstable: tests ran and some failed. See the JUnit results.' }
  }
}
