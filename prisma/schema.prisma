// Portfolio data: contact enquiries and the metadata of their S3 attachments (files themselves
// live in S3, never in the database). Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// The connection URL lives in prisma.config.ts / DATABASE_URL, never here.
datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// One contact form enquiry.
model ContactMessage {
  id           String      @id @default(cuid())
  /// Generated by the form per attempt and reused on retry, so a retry never creates a duplicate.
  submissionId String      @unique
  fullName     String
  email        String
  mobileNumber String?
  company      String?
  projectType  String
  message      String
  /// Whether the notification email went out (retries resend only while not SENT).
  emailStatus  EmailStatus @default(PENDING)
  attachment   Media?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([createdAt])
  @@index([email])
}

/// Metadata for a file stored in S3 (key = object key in the bucket).
model Media {
  id               String          @id @default(cuid())
  key              String          @unique
  filename         String
  mimeType         String
  size             Int
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)
  contactMessageId String?         @unique
  createdAt        DateTime        @default(now())
}
