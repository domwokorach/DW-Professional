generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageSender {
  VISITOR
  ADMIN
  BOT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum Role {
  ADMIN
  SUPPORT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AvailabilityStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

enum SecurityEventType {
  SIGN_IN
  SIGN_OUT
  FAILED_SIGN_IN
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  SESSION_REVOKED
  ACCOUNT_LOCKED
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String
  role            Role       @default(ADMIN)
  status          UserStatus @default(ACTIVE)
  avatarUrl       String?
  availability    AvailabilityStatus @default(OFFLINE)
  preferences     Json       @default("{}")
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastLoginAt     DateTime?

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  emailChangeRequests  EmailChangeRequest[]
  securityEvents       SecurityEvent[]

  @@index([email])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceId         String
  deviceName       String
  deviceType       String
  operatingSystem  String
  browser          String
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityEvents  SecurityEvent[]

  @@index([userId])
  @@index([deviceId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailChangeRequest {
  id         String    @id @default(cuid())
  userId     String
  oldEmail   String
  newEmail   String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String
  sessionId String?
  type      SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Comment {
  id              String        @id @default(cuid())
  fullName        String
  company         String?
  companyId       String?
  companyNumber   String?
  companyStatus   String?
  companySource   String?
  companyDomain   String?
  companyLogo     String?
  companyIndustry String?
  companyLocation String?
  body            String
  avatarUrl       String?
  status          CommentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviewedAt      DateTime?
  reviewedBy      String?

  @@index([status, createdAt])
}

/** Holds a pending comment submission until its email PIN is verified; only then is a Comment row created. */
model CommentVerification {
  id              String    @id @default(cuid())
  email           String
  mobile          String
  fullName        String
  company         String?
  companyId       String?
  companyNumber   String?
  companyStatus   String?
  companySource   String?
  companyDomain   String?
  companyLogo     String?
  companyIndustry String?
  companyLocation String?
  body            String
  avatarUrl       String?
  pinHash         String
  attempts        Int       @default(0)
  expiresAt       DateTime
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([email, createdAt])
}

model Conversation {
  id              String             @id @default(cuid())
  visitorId       String
  name            String?
  email           String?
  mobile          String?
  companyName     String?
  status          ConversationStatus @default(OPEN)
  assignedAdminId String?
  unreadByAdmin   Int                @default(0)
  unreadByVisitor Int                @default(0)
  lastMessageAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  messages        Message[]

  // A partial unique index on (visitorId) WHERE status IN (OPEN, PENDING)
  // also exists (see migration 20260914162500_conversation_visitor_active_unique)
  // enforcing at most one active conversation per visitor. Prisma's schema
  // language can't express a partial index, so it isn't declared here —
  // findOrCreateConversation relies on it to resolve concurrent create races.
  @@index([visitorId])
  @@index([status, lastMessageAt])
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  sender          MessageSender
  senderId        String?
  content         String
  status          MessageStatus @default(SENT)
  clientMessageId String?       @unique
  createdAt       DateTime      @default(now())
  readAt          DateTime?
  deletedAt       DateTime?

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
