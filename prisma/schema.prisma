generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageSender {
  VISITOR
  ADMIN
  BOT
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum Role {
  ADMIN
  SUPPORT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AvailabilityStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
}

enum SecurityEventType {
  SIGN_IN
  SIGN_OUT
  FAILED_SIGN_IN
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  SESSION_REVOKED
  ACCOUNT_LOCKED
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String
  role            Role       @default(ADMIN)
  status          UserStatus @default(ACTIVE)
  avatarUrl       String?
  availability    AvailabilityStatus @default(OFFLINE)
  preferences     Json       @default("{}")
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastLoginAt     DateTime?

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  emailChangeRequests  EmailChangeRequest[]
  securityEvents       SecurityEvent[]

  @@index([email])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  deviceId         String
  deviceName       String
  deviceType       String
  operatingSystem  String
  browser          String
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityEvents  SecurityEvent[]

  @@index([userId])
  @@index([deviceId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailChangeRequest {
  id         String    @id @default(cuid())
  userId     String
  oldEmail   String
  newEmail   String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String
  sessionId String?
  type      SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Comment {
  id              String        @id @default(cuid())
  fullName        String
  company         String?
  companyId       String?
  companyNumber   String?
  companyStatus   String?
  companySource   String?
  companyDomain   String?
  companyLogo     String?
  companyIndustry String?
  companyLocation String?
  companyPostcode String?
  body            String
  avatarUrl       String?
  status          CommentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  reviewedAt      DateTime?
  reviewedBy      String?

  @@index([status, createdAt])
}

/** Holds a pending comment submission until its email PIN is verified; only then is a Comment row created. */
model CommentVerification {
  id              String    @id @default(cuid())
  email           String
  fullName        String
  company         String?
  companyId       String?
  companyNumber   String?
  companyStatus   String?
  companySource   String?
  companyDomain   String?
  companyLogo     String?
  companyIndustry String?
  companyLocation String?
  companyPostcode String?
  body            String
  avatarUrl       String?
  pinHash         String?
  attempts        Int       @default(0)
  expiresAt       DateTime
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([email, createdAt])
}

model Conversation {
  id              String             @id @default(cuid())
  visitorId       String
  name            String?
  email           String?
  mobile          String?
  companyName     String?
  status          ConversationStatus @default(OPEN)
  assignedAdminId String?
  unreadByAdmin   Int                @default(0)
  unreadByVisitor Int                @default(0)
  lastMessageAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  messages        Message[]

  // A partial unique index on (visitorId) WHERE status IN (OPEN, PENDING)
  // also exists (see migration 20260914162500_conversation_visitor_active_unique)
  // enforcing at most one active conversation per visitor. Prisma's schema
  // language can't express a partial index, so it isn't declared here —
  // findOrCreateConversation relies on it to resolve concurrent create races.
  @@index([visitorId])
  @@index([status, lastMessageAt])
}

// Local mirror of Companies House's free "Basic Company Data" bulk CSV
// export (https://download.companieshouse.gov.uk/en_output.html), imported
// via scripts/import-companies-house-csv.mjs. Company search reads from this
// table instead of calling the Companies House REST API — no API key or
// network dependency at request time.
model CompanyRecord {
  id                String    @id @default(cuid())
  companyNumber     String    @unique
  name              String
  // Lowercased, whitespace-collapsed copy of `name`, used for indexed
  // equality/prefix search so the original display casing in `name` is
  // never altered.
  nameNormalized    String
  status            String?
  category          String?
  incorporationDate DateTime?
  addressLine1      String?
  addressLine2      String?
  locality          String?
  region            String?
  postalCode        String?
  // Lowercased, space-stripped copy of `postalCode` (e.g. "sw1a2aa"), so a
  // search matches "SW1A 2AA" and "sw1a2aa" alike while `postalCode` keeps
  // its original, displayable formatting.
  postcodeNormalized String?
  country           String?
  // Companies House's per-company profile URL from the bulk export's URI column.
  uri               String?
  sicCodes          String[]  @default([])
  // Tags which import run last wrote/touched this row. A monthly full-file
  // reimport upserts every row with a new generation and then deletes only
  // rows left on an older generation — see
  // scripts/import-companies-house-csv.mjs — so search never sees the
  // table empty or half-replaced mid-import.
  importGeneration  BigInt    @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([name])
  @@index([nameNormalized])
  @@index([postcodeNormalized])
  @@index([status])
  @@index([importGeneration])
}

// One row per attempt to import CompanyRecord from the configured R2/S3
// object (see scripts/import-companies-house-s3.mjs and
// src/app/api/admin/companies/import/s3/route.ts). "running" rows double as
// resume checkpoints: byteOffset + headerFields let a restarted run seek
// straight to where it left off with `Range: bytes=<byteOffset>-` instead of
// re-streaming the whole file, and generation ties the run to the
// CompanyRecord.importGeneration batch it wrote so stale-row cleanup only
// happens after a run reaches "succeeded".
model CompanyImportRun {
  id            String    @id @default(cuid())
  // "<bucket>/<key>", e.g. "dw-portfoilo/BasicCompanyDataAsOneFile-2026.csv".
  sourceKey     String
  generation    BigInt
  status        String    @default("running") // "running" | "succeeded" | "failed"
  // Column-name -> index map read from the CSV header, saved so a resumed
  // run (which seeks past the header) doesn't need to re-read it.
  headerFields  Json?
  byteOffset    BigInt    @default(0)
  totalBytes    BigInt?
  rowCount      Int       @default(0)
  rejectedRows  Int       @default(0)
  // Capped sample of {row, reason} entries — not every rejection, just
  // enough to diagnose a bad file without unbounded row storage.
  errorDetails  Json?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([sourceKey, status])
  @@index([sourceKey, startedAt])
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  sender          MessageSender
  senderId        String?
  content         String
  status          MessageStatus @default(SENT)
  clientMessageId String?       @unique
  createdAt       DateTime      @default(now())
  readAt          DateTime?
  deletedAt       DateTime?

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
