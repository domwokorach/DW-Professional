// Portfolio data: contact enquiries, the metadata of their S3 attachments (files themselves live in S3,
// never in the database) and visitor comments for "What people are saying". Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// The connection URL lives in prisma.config.ts / DATABASE_URL, never here.
datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One contact form enquiry.
model ContactMessage {
  id             String      @id @default(cuid())
  /// Generated by the form per attempt and reused on retry, so a retry never creates a duplicate.
  submissionId   String      @unique
  fullName       String
  email          String
  mobileNumber   String?
  company        String?
  /// Set when the visitor picked a registered UK company in the Company field (text: keeps leading zeros).
  companyNumber  String?
  /// Status and registered office address as Companies House (or the imported dataset) reported them at submission.
  companyStatus  String?
  companyAddress String?
  projectType    String
  message        String
  /// Whether the notification email went out (retries resend only while not SENT).
  emailStatus    EmailStatus @default(PENDING)
  attachment     Media?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([createdAt])
  @@index([email])
}

/// Metadata for a file stored in S3 (key = object key in the bucket).
model Media {
  id               String          @id @default(cuid())
  key              String          @unique
  filename         String
  mimeType         String
  size             Int
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)
  contactMessageId String?         @unique
  createdAt        DateTime        @default(now())
}

/// A visitor's comment for the "What people are saying" section. New comments are always PENDING; only an
/// authenticated admin can approve or reject them (/admin/comments), and only APPROVED ones are shown publicly.
/// Email, device, IP address and consent are private moderation data: never returned by a public API.
model Comment {
  id                 String        @id @default(cuid())
  /// Generated by the form per attempt and reused on retry, so a double click or retry never creates a duplicate.
  submissionId       String        @unique
  fullName           String
  email              String
  company            String?
  /// Company lookup details are private moderation data; free text leaves these null and verified false.
  companyNumber      String?
  companyStatus      String?
  companyType        String?
  companyLocality    String?
  companyVerified    Boolean       @default(false)
  companyVerificationSource String?
  companyVerifiedAt  DateTime?
  comment            String
  /// S3 object key of the optional avatar (served through /api/comments/[id]/avatar, never a public bucket URL).
  avatarKey          String?
  /// Device / platform summary derived from the request headers, e.g. "Desktop · macOS · Chrome".
  device             String?
  ipAddress          String?
  /// The visitor ticked the moderation permission checkbox; the server refuses submissions without it.
  consentGiven       Boolean
  consentGivenAt     DateTime
  status             CommentStatus @default(PENDING)
  /// Whether the moderation notification email went out.
  notificationStatus EmailStatus   @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  moderatedAt        DateTime?
  moderatedBy        AdminUser?    @relation("CommentModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedById      String?
  /// Set only by an admin ("Mark as verified" in /admin/comments), separately from approval: an APPROVED comment is
  /// published without the verified badge unless this is true. Cleared when the comment stops being APPROVED.
  /// Never settable through the public form or API.
  isVerified         Boolean       @default(false)
  verifiedAt         DateTime?
  verifiedBy         AdminUser?    @relation("CommentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedById       String?
  /// Set only by an admin ("Show in italics" in /admin/comments): the comment's text shows in italics on the public
  /// card. A display choice only, independent of approval and verification. Never settable through the public form or API.
  isItalic           Boolean       @default(false)

  /// The public feed: approved comments, newest first. Also the admin status filters.
  @@index([status, createdAt])
  /// Per-IP submission rate limit.
  @@index([ipAddress, createdAt])
}

enum AdminRole {
  ADMIN
}

/// An administrator. Created from the command line (npm run admin -- create), never through the site.
model AdminUser {
  id                String          @id @default(cuid())
  /// Stored lower-cased.
  email             String          @unique
  /// Argon2id hash (PHC string). Never selected for anything but the password check.
  passwordHash      String
  role              AdminRole       @default(ADMIN)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lastLoginAt       DateTime?
  sessions          AdminSession[]
  auditLogs         AdminAuditLog[]
  moderatedComments Comment[]       @relation("CommentModeratedBy")
  verifiedComments  Comment[]       @relation("CommentVerifiedBy")
}

/// A signed-in admin session. The browser holds only the random token (HttpOnly cookie); this stores its SHA-256.
model AdminSession {
  id               String    @id @default(cuid())
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  adminUserId      String
  sessionTokenHash String    @unique
  createdAt        DateTime  @default(now())
  /// Absolute expiry, fixed at sign-in.
  expiresAt        DateTime
  /// Updated on authenticated requests; the session also ends after a period of inactivity.
  lastActivityAt   DateTime  @default(now())
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?

  @@index([adminUserId])
}

enum AdminAuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_THROTTLED
  LOGOUT
  SESSION_REVOKED
  PASSWORD_CHANGED
  COMMENT_APPROVED
  COMMENT_REJECTED
  COMMENT_DELETED
  COMMENT_VERIFIED
  COMMENT_UNVERIFIED
  COMMENT_ITALIC_ON
  COMMENT_ITALIC_OFF
  PORTFOLIO_ACCESS_DELETED
}

/// Security-relevant admin events. Never holds passwords or tokens.
model AdminAuditLog {
  id                String          @id @default(cuid())
  /// Null for failed sign-ins with an unknown email.
  adminUser         AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminUserId       String?
  event             AdminAuditEvent
  /// The comment acted on (kept after the comment itself is deleted).
  commentId         String?
  /// The Portfolio Access submission acted on (kept after the submission itself is deleted).
  portfolioAccessId String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime        @default(now())

  @@index([adminUserId, createdAt])
  @@index([event, createdAt])
}

/// Sign-in attempts, for throttling brute force by IP address and by account. `emailHash` is a SHA-256 of the
/// lower-cased email, so attempts against unknown addresses don't store them.
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  emailHash String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([emailHash, createdAt])
}

/// One Portfolio Access session: a candidate who scanned the Developer ID QR code and filled in the form before
/// opening the CV. One session per email address (case-insensitive): submitting again updates it (latest details,
/// IP and device, a higher submission count) and adds any new file. Device and IP address are disclosed on the form
/// and captured on the server (never from the browser). Private: listed only at /admin/sessions.
model PortfolioAccess {
  id                  String                @id @default(cuid())
  /// The first submission's id (sent by the form, reused on retry).
  submissionId        String                @unique
  /// The latest submission's id, so a retry of an update is recognised as a repeat too.
  lastSubmissionId    String?
  fullName            String
  email               String
  /// Lower-cased email: the key that makes a repeat submission update this session.
  emailKey            String
  mobile              String
  company             String?
  /// Set when the visitor picked a registered UK company in the Company field.
  companyNumber       String?
  /// Optional professional profile links the visitor added (absolute http(s) URLs, validated on the server).
  linkedinUrl         String?
  companyWebsite      String?
  portfolioUrl        String?
  /// "Continue with LinkedIn" (OpenID Connect): only what LinkedIn returned for the member who signed in. The profile
  /// URL is never derived from these; linkedinUrl above is only ever what the candidate typed.
  linkedinMemberId    String?
  linkedinName        String?
  linkedinEmail       String?
  linkedinAvatarUrl   String?
  linkedinConnectedAt DateTime?
  /// Device / platform summary derived from the request headers, e.g. "Mobile · iOS · Safari" (latest submission).
  device              String?
  userAgent           String?
  /// From the hosting platform's trusted headers (latest submission); null when it can't be determined reliably.
  ipAddress           String?
  /// Where the visit came from, e.g. "Portfolio Access QR Code".
  source              String
  page                String
  /// Whether the latest notification email went out (retries resend only while not SENT).
  notificationStatus  EmailStatus           @default(PENDING)
  /// How many times this candidate has submitted the form.
  submissionCount     Int                   @default(1)
  /// First submission.
  createdAt           DateTime              @default(now())
  lastSubmittedAt     DateTime              @default(now())
  /// Files the candidate uploaded or photographed, across all their submissions. Deleted with the session.
  attachments         PortfolioAccessFile[]

  @@index([createdAt])
  @@index([lastSubmittedAt])
  @@index([emailKey])
  @@index([email, createdAt])
  /// Per-IP submission rate limit.
  @@index([ipAddress, createdAt])
}

/// A file attached to a Portfolio Access session: a PNG or JPG image (possibly from the camera) or a PDF, DOC or
/// DOCX document. Kept in the database rather than S3 so it never depends on bucket credentials; capped at 4 MB on
/// the server. Private: only served to a signed-in admin (/api/admin/portfolio-access/files/[id]).
model PortfolioAccessFile {
  id        String          @id @default(cuid())
  access    PortfolioAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  accessId  String
  /// Sanitised original name, e.g. "business-card.jpg".
  filename  String
  /// Set from the checked file signature, never from the browser.
  mimeType  String
  size      Int
  /// "upload" or "camera".
  source    String
  data      Bytes
  /// When it was uploaded (the submission it came with).
  createdAt DateTime        @default(now())

  @@index([accessId, createdAt])
}
