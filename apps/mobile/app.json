{
  "expo": {
    "name": "DW Professional",
    "slug": "dw-professional",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dwprofessional",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.dominicwokorach.portfolio"
    },
    "android": {
      "package": "me.dominicwokorach.portfolio",
      "adaptiveIcon": {
        "backgroundColor": "#25233f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f1eedf",
          "dark": {
            "backgroundColor": "#14132a"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
