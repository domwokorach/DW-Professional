# Live chat (Socket.IO). The server runs as its own process — `npm run socket:dev` —
# separate from `next dev`. Point the browser client at it with the NEXT_PUBLIC_ var,
# and restrict the server's CORS origin to the site's actual origin(s) in production.
# Production (Vercel): redeploy after changing this build-time value.
NEXT_PUBLIC_SOCKET_URL=https://dw-professional.onrender.com
# Local development only: NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
SOCKET_PORT=3001
SOCKET_CORS_ORIGIN=http://localhost:3000
# Shared secret used to sign/verify short-lived connection tokens (POST /api/live-chat/token
# mints them; the socket server verifies them). Must be set to the SAME value for both the
# Next.js app and the socket:dev/socket:start process. Never expose this with a NEXT_PUBLIC_
# prefix or send it to the browser directly — only the signed, short-lived token travels there.
SOCKET_SECRET=replace_with_a_long_random_string

# --- JWT authentication (see src/lib/auth/) -------------------------------
# Signs/verifies short-lived access tokens (~12 min). Long, random, and
# distinct from TOKEN_HASH_PEPPER. Never expose to the browser.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
# Not currently used to sign a token (refresh tokens are opaque, hashed
# values — see src/lib/auth/session.ts) but reserved for a future HMAC step;
# keep it set to a long random string distinct from JWT_ACCESS_SECRET.
TOKEN_HASH_PEPPER=replace_with_a_different_long_random_string

# Canonical server-side origin used to build absolute links in transactional emails
# (password reset, email verification, new-device alerts). No trailing slash.
APP_URL=https://dominicwokorach.me

# Public origin used by client-side code (e.g. the socket client). No trailing slash.
NEXT_PUBLIC_APP_URL=https://www.dominicwokorach.me

# There is no public sign-up route — provision the first admin account with:
#   npm run auth:create-admin -- "Your Name" you@example.com "a-strong-password" SUPER_ADMIN
# Or, to seed a single fixed super_admin account idempotently (prisma/seed.ts,
# run automatically by `prisma migrate dev`/`db seed`, or manually via `npm run db:seed`):
#   Never use a NEXT_PUBLIC_ prefix for either of these — the password must stay server-only.
ADMIN_INITIAL_EMAIL=replace_with_the_admin_email
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password

# Server-only credentials. Never expose these with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=replace_with_a_rotated_key
OPENAI_VECTOR_STORE_ID=vs_replace_with_your_vector_store_id

OPENWEATHER_API_KEY=replace_with_your_openweather_api_key

# Transactional email (see src/services/email/). RESEND_API_KEY is server-only —
# never expose it with a NEXT_PUBLIC_ prefix.
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME="Dominic Wokorach"
EMAIL_FROM_ADDRESS=no-reply@dominicwokorach.me
RESEND_API_KEY=replace_with_your_resend_api_key

# HMAC signing key for the resume PIN verification flow (any long random string)
RESUME_PIN_SECRET=replace_with_a_long_random_string

# Preferred: Google Cloud Translation via a service account (Cloud Translation v3 API).
# Create this service account in IAM & Admin, grant it the "Cloud Translation API User" role,
# and use its JSON key's fields below. Never commit the private key.
GOOGLE_CLOUD_PROJECT_ID=replace_with_your_gcp_project_id
GOOGLE_CLOUD_CLIENT_EMAIL=replace_with_your_service_account_email
GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_your_service_account_private_key\n-----END PRIVATE KEY-----\n"

# Fallback: a plain Google Cloud Translation API key (v2 API), used if the service account
# variables above are not set. Restrict it to this API and deployment.
TRANSLATION_API_KEY=replace_with_your_google_cloud_translation_api_key

# Optional override for the fallback provider endpoint (defaults to the Google Cloud Translation v2 API).
TRANSLATION_API_URL=https://translation.googleapis.com/language/translate/v2

# Render API Key
RENDER_API_KEY=replace_with_your_render_api_key
