# Public site origin (used for canonical URLs/metadata). Production: https://www.dominicwokorach.me
NEXT_PUBLIC_SITE_URL=

# Contact form email (server-side only — never prefix with NEXT_PUBLIC_).
# Provisioned automatically by the Vercel Marketplace Resend integration:
RESEND_API_KEY=
# Where enquiries are delivered:
CONTACT_TO_EMAIL=
# Sender; must use a domain verified in Resend. Defaults to Resend's onboarding sender,
# which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=

# Contact attachments in Amazon S3 (optional; server-side only — never prefix with NEXT_PUBLIC_).
# With AWS_S3_BUCKET_NAME + AWS_REGION set, attachments upload straight to a private bucket via
# short-lived presigned URLs (up to 10 MB) and the enquiry email links to them. Without them, files
# up to 4 MB are attached to the email instead. Setup (CORS, IAM policy, lifecycle): docs/S3_SETUP.md
AWS_REGION=
AWS_S3_BUCKET_NAME=
# Local development only. In production prefer the host's IAM role / OIDC so no long-lived keys exist.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# PostgreSQL for Prisma (server-side only). Stores contact enquiries + attachment metadata.
# The portfolio's tables live in their own Postgres schema (DATABASE_SCHEMA, default "portfolio"),
# applied by prisma.config.ts and the runtime client, so migrations never touch other schemas.
DATABASE_URL=
# Optional: takes precedence over DATABASE_URL (use when DATABASE_URL is reserved for another app).
PORTFOLIO_DATABASE_URL=
DATABASE_SCHEMA=portfolio

# Visitor comments ("What people are saying") are saved in the same database as PENDING and moderated at
# /admin/comments (see docs/COMMENTS.md). Each new comment emails the moderator (via RESEND_API_KEY and
# CONTACT_FROM_EMAIL above). Optional override for where that email goes:
COMMENTS_NOTIFY_EMAIL=dominic.wokorach-o@outlook.com

# First admin account for /admin/login. There is NO default login: the account exists only after you put your
# own values here and run `npx prisma db seed` (the password is hashed with Argon2id; the plaintext is never
# stored). Placeholder values like these are refused. Keep the real ones in .env only (it is not committed), never
# prefix them with NEXT_PUBLIC_, and remove ADMIN_PASSWORD once the account exists. Afterwards use
# `npm run admin -- reset-password <email>`. Full steps: README, "Admin sign-in".
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="change-this-password"
# Optional: ADMIN_RESET_PASSWORD=true makes the seed replace the password of an admin that already exists.

# --------------------------------------------------------------------------------------------
# Company data (optional, server-side only). Powers the contact form's Company (optional) suggestions;
# without it the field is a plain text input. The Companies House CSV in S3 is imported by hand
# (npm run companies:import) into a separate database and searched through GET /api/companies/search
# (404 until COMPANY_DATABASE_URL is set).
# Setup and security notes: docs/COMPANIES.md
# --------------------------------------------------------------------------------------------
# The dataset object. This is NOT the attachments bucket above; the two are deliberately separate.
AWS_S3_BUCKET=
AWS_S3_KEY=
# Or the same location as one URI (used when AWS_S3_BUCKET/AWS_S3_KEY are unset), e.g.
# s3://my-bucket/BasicCompanyData-YYYY-MM-DD.csv. A newer dataset only needs this config changed.
COMPANIES_S3_URI=
# Leave unset for native AWS S3 (the SDK derives the endpoint from AWS_REGION). Set it only for a
# non-AWS S3-compatible store, e.g. Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT=
# Its own database, never DATABASE_URL. Tables live in the COMPANY_DATABASE_SCHEMA schema.
COMPANY_DATABASE_URL=
COMPANY_DATABASE_SCHEMA=companies
# Companies House public data API key (REST key, sent as Basic auth by the server only). Verifies a
# picked company and refreshes its details via GET /api/companies/verify; without it the imported
# record is used. https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
# OAuth client (filing on behalf of users). Not used for company search; keep separate if ever needed.
# COMPANIES_HOUSE_CLIENT_ID=
# COMPANIES_HOUSE_CLIENT_SECRET=

# Live weather in About > Quick Facts (optional, server-side only — never prefix with NEXT_PUBLIC_).
# OpenWeather API key; without it the row shows "Currently unavailable". Cached for 20 minutes.
OPENWEATHER=

# "Continue with LinkedIn" on /en-gb/portfolio-access (Sign In with LinkedIn using OpenID Connect).
# Create an app at https://www.linkedin.com/developers/apps, add the product "Sign In with LinkedIn using OpenID
# Connect", and add these Authorized redirect URLs on the Auth tab:
#   https://www.dominicwokorach.me/api/auth/linkedin/callback
#   http://localhost:3000/api/auth/linkedin/callback
# Server-only: never prefix these with NEXT_PUBLIC_. The button stays hidden until both are set.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: force the callback URL (otherwise it's this site's origin + /api/auth/linkedin/callback).
LINKEDIN_REDIRECT_URI=
